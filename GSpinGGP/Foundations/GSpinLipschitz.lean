import GSpinGGP.Foundations.QuadraticForms
import TauCeti.LinearAlgebra.CliffordAlgebra.Lipschitz.CliffordGroup

/-!
# `GSpin` and the Lipschitz group

For a nondegenerate quadratic form that represents a unit, `GSpin Q` (normalizer form,
Thesis §5.1.2) is the even part of Mathlib's Lipschitz group `lipschitzGroup Q`, the group
generated by invertible vectors. The proof uses Tau Ceti's identification of the Lipschitz group
with the classical Clifford group (`CliffordAlgebra.mem_lipschitzGroup_of_involute_act_ι_mem_range_ι`).

The hypothesis that `Q` represents a unit is needed: for `V = 0`, `GSpin Q = Kˣ` while the
Lipschitz group is trivial.
-/

open CliffordAlgebra

namespace GSpinGGP

variable {K : Type*} [Field K] [Invertible (2 : K)]
  {V : Type*} [AddCommGroup V] [Module K V] [FiniteDimensional K V]

/-- `GSpin Q` is the even part of the Lipschitz group, for nondegenerate `Q` representing a
unit. -/
theorem mem_GSpin_iff_mem_lipschitzGroup (Q : QuadraticForm K V) (hQ : IsNondeg Q)
    (hv : ∃ v, IsUnit (Q v)) (g : (CliffordAlgebra Q)ˣ) :
    g ∈ GSpin Q ↔ g ∈ lipschitzGroup Q ∧ (g : CliffordAlgebra Q) ∈ even Q := by
  have hQ' : Q.Nondegenerate := (isNondeg_iff_nondegenerate Q).1 hQ
  constructor
  · rintro ⟨heven, hconj, -⟩
    refine ⟨mem_lipschitzGroup_of_involute_act_ι_mem_range_ι Q hQ' hv fun m => ?_, heven⟩
    rw [involute_eq_of_mem_even heven]
    exact hconj m
  · rintro ⟨hL, heven⟩
    have hinv : involute (Q := Q) ((g⁻¹ : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) =
        ((g⁻¹ : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) := by
      have h1 := congrArg (involute (Q := Q))
        (Units.inv_mul g : ((g⁻¹ : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) * g = 1)
      rw [map_mul, map_one, involute_eq_of_mem_even heven] at h1
      exact (Units.inv_eq_of_mul_eq_one_left h1).symm
    refine ⟨heven, fun v => ?_, fun v => ?_⟩
    · have := lipschitzGroup.involute_act_ι_mem_range_ι hL v
      rwa [involute_eq_of_mem_even heven] at this
    · have := lipschitzGroup.involute_act_ι_mem_range_ι (inv_mem hL) v
      rwa [hinv, inv_inv] at this

end GSpinGGP
